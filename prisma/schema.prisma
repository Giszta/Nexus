generator client { 
  provider = "prisma-client-js" 
  }

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  role          String    @default("AGENT")
  createdAt     DateTime
  updatedAt     DateTime
  ticketActivities TicketActivity[]

  sessions      Session[]
  accounts      Account[]

  ticketsCreated  Ticket[] @relation("TicketsCreated")
  ticketsAssigned Ticket[] @relation("TicketsAssigned")
  
  knowledgeDocuments KnowledgeDocument[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum TicketCategory {
  HARDWARE
  SOFTWARE
  BILLING
  ACCOUNT
  OTHER
}

model Ticket {
  id          String          @id @default(cuid())
  title       String
  description String
  status      TicketStatus    @default(OPEN)
  priority    TicketPriority?
  category    TicketCategory?
  activities TicketActivity[]

  createdById String
  createdBy   User            @relation("TicketsCreated", fields: [createdById], references: [id])

  assignedToId String?
  assignedTo   User?          @relation("TicketsAssigned", fields: [assignedToId], references: [id])

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status])
  @@index([createdById])
  @@map("ticket")

  analyses AIAnalysis[]
  suggestions AISuggestion[]
}

enum TicketActivityType {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  PRIORITY_CHANGED
}

model TicketActivity {
  id        String             @id @default(cuid())
  type      TicketActivityType
  fromValue String?
  toValue   String?

  ticketId  String
  ticket    Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  actorId   String
  actor     User               @relation(fields: [actorId], references: [id])

  createdAt DateTime           @default(now())

  @@index([ticketId])
  @@map("ticket_activity")
}

model AIAnalysis {
  id            String          @id @default(cuid())

  ticketId      String
  ticket        Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  model         String
  promptVersion String
  category      TicketCategory?
  priority      TicketPriority?
  confidence    Float
  reasoning     String?

  latencyMs     Int
  inputTokens   Int?
  outputTokens  Int?

  createdAt     DateTime        @default(now())

  @@index([ticketId])
  @@map("ai_analysis")
}

model AISuggestion {
  id            String   @id @default(cuid())

  ticketId      String
  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  content       String
  model         String
  promptVersion String

  latencyMs     Int
  inputTokens   Int?
  outputTokens  Int?

  createdAt     DateTime @default(now())

  @@index([ticketId])
  @@map("ai_suggestion")
}

enum DocumentStatus {
  UPLOADING
  PROCESSING
  INDEXING
  READY
  FAILED
}

enum DocumentFileType {
  TXT
  MARKDOWN
}

model KnowledgeDocument {
  id           String           @id @default(cuid())
  title        String
  content      String
  fileType     DocumentFileType
  status       DocumentStatus   @default(UPLOADING)
  fileSizeBytes Int

  uploadedById String
  uploadedBy   User             @relation(fields: [uploadedById], references: [id])

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status])
  @@map("knowledge_document")

  chunks KnowledgeChunk[]
}

model KnowledgeChunk {
  id         String              @id @default(cuid())
  content    String
  chunkIndex Int
  embedding  Unsupported("vector(1024)")?

  documentId String
  document   KnowledgeDocument   @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdAt  DateTime            @default(now())

  @@index([documentId])
  @@map("knowledge_chunk")
}